<UserControl x:Class="JtlSyncEngine.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JtlSyncEngine.Views"
             Background="#04060f"
             x:Name="settingsRoot">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:NotBooleanConverter x:Key="NotBool"/>
            <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="28,24,28,24">

            <!-- Header -->
            <TextBlock Text="Settings"
                       Foreground="#f1f5f9"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Portable Click-to-Run Mode" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="The scheduler runs while JtlSyncEngine.exe is open or minimized to the tray. No installer or Windows service is required."
                               Foreground="#94a3b8" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource BaseButton}" Command="{Binding OpenServiceLogsCommand}" Margin="0,0,8,8" Content="Open Logs"/>
                    </WrapPanel>
                    <TextBlock Text="Enable Start with Windows below if this Sync Engine must start automatically after user sign-in."
                               Foreground="#64748b"
                               FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- SQL Server Connection -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SQL Server Connection" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SuccessButton}"
                                    Command="{Binding AutoDetectJtlCommand}"
                                    Padding="14,7"
                                    Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2605; " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Auto-Detect JTL" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding AutoDetectResult}"
                               Foreground="{Binding AutoDetectColor}"
                               FontSize="12"
                               Margin="0,-8,0,12"
                               Visibility="{Binding AutoDetectResult, Converter={StaticResource NotEmptyToVis}}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Host" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding SqlHost, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding SqlPort, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Database" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SqlDatabase, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <CheckBox Style="{StaticResource DarkCheckBox}"
                              IsChecked="{Binding SqlWindowsAuth}"
                              Content="Use Windows Authentication"
                              Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding SqlWindowsAuth, Converter={StaticResource NotBool}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Style="{StaticResource DarkPasswordBox}"
                                         x:Name="sqlPasswordBox"
                                         IsEnabled="{Binding SqlWindowsAuth, Converter={StaticResource NotBool}}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BaseButton}"
                                Command="{Binding TestSqlCommand}"
                                Margin="0,0,12,0">
                            <TextBlock Text="Test Connection"/>
                        </Button>
                        <TextBlock Text="{Binding SqlTestResult}"
                                   Foreground="{Binding SqlTestColor}"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backend API -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Backend API" Style="{StaticResource SectionHeader}"/>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Backend URL" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding BackendApiUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Style="{StaticResource DarkPasswordBox}"
                                         x:Name="apiKeyBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BaseButton}"
                                Command="{Binding TestApiCommand}"
                                Margin="0,0,12,0">
                            <TextBlock Text="Test API"/>
                        </Button>
                        <TextBlock Text="{Binding ApiTestResult}"
                                   Foreground="{Binding ApiTestColor}"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sync Schedule -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Sync Schedule (interval in minutes)" Style="{StaticResource SectionHeader}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="Orders (minutes)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding OrdersSyncInterval, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Text="Products (minutes)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding ProductsSyncInterval, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Text="Customers (minutes)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding CustomersSyncInterval, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Text="Inventory (minutes)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding InventorySyncInterval, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Batch Settings -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Batch Settings" Style="{StaticResource SectionHeader}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Batch Size (rows per API call)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Batch Delay (ms between batches)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding BatchDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Order Status Lookback (days)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding OrdersStatusLookbackDays, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Re-sync recent orders every run to capture cancel/return status changes."
                                   Foreground="#64748b"
                                   FontSize="11"
                                   Margin="2,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Inventory Safety -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Inventory Safety" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Default is legacy. Use auto with diagnostics/dry-run before real adaptive inventory sync."
                               Foreground="#64748b"
                               FontSize="11"
                               Margin="2,-4,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Inventory Source Mode (legacy / auto)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding InventorySourceMode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Zero Stock Policy (verify / allow)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding InventoryZeroStockPolicy, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      IsChecked="{Binding JtlReadOnlyMode}"
                                      Content="Read-only SQL guard"
                                      Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      IsChecked="{Binding InventoryDiagnosticsOnly}"
                                      Content="Diagnostics only"
                                      Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      IsChecked="{Binding InventoryDryRun}"
                                      Content="Dry-run: skip backend push"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      IsChecked="{Binding InventoryAllowConfirmedZeroStock}"
                                      Content="Allow confirmed zero stock"
                                      Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      IsChecked="{Binding InventoryRejectUnverifiedZeroStock}"
                                      Content="Reject unverified zero stock"
                                      Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      IsChecked="{Binding InventoryRejectConflictingStockSources}"
                                      Content="Reject conflicting stock sources"
                                      Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      IsChecked="{Binding InventoryRequireSourceMetadata}"
                                      Content="Require inventory source metadata"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BaseButton}"
                                Command="{Binding RunInventoryDiagnosticsCommand}"
                                Margin="0,0,12,0">
                            <TextBlock Text="Run Inventory Diagnostics"/>
                        </Button>
                        <TextBlock Text="{Binding InventoryDiagnosticsResult}"
                                   Foreground="{Binding InventoryDiagnosticsColor}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Update Settings -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Secure In-Place Updates" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="The portable app downloads a signed release, exits safely, lets the trusted updater replace its files, then starts again automatically."
                               Foreground="#64748b" FontSize="11" Margin="0,-4,0,12"/>
                    <WrapPanel Margin="0,0,0,12">
                        <CheckBox Style="{StaticResource DarkCheckBox}" IsChecked="{Binding UpdatesEnabled}"
                                  Content="Updates enabled" Margin="0,0,22,8"/>
                        <CheckBox Style="{StaticResource DarkCheckBox}" IsChecked="{Binding AutomaticDownload}"
                                  Content="Automatic download" Margin="0,0,22,8"/>
                        <CheckBox Style="{StaticResource DarkCheckBox}" IsChecked="{Binding AutomaticInstall}"
                                  Content="Allow approved maintenance-window install" Margin="0,0,22,8"/>
                    </WrapPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Channel (stable / beta)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ReleaseChannel, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Window start (HH:mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding MaintenanceWindowStart, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Window end (HH:mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding MaintenanceWindowEnd, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Allowed days (comma separated)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding AllowedUpdateDays, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Health timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding UpdateHealthTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Backups to keep (1–5)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding UpdateBackupsToKeep, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Installed version" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding CurrentInstalledVersion}" Foreground="#f1f5f9"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Installed Git SHA" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding CurrentInstalledGitSha}" Foreground="#94a3b8" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Available / last result" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding AvailableUpdateVersion}" Foreground="#34d399"/><TextBlock Text="{Binding LastUpdateResult}" Foreground="#64748b" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- App Settings -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="App Settings" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Starting after a restart"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#e2e8f0"
                               Margin="0,0,0,8"/>

                    <!-- Two separate mechanisms, deliberately two separate checkboxes.
                         They have different requirements and different reboot behaviour,
                         so one control could only describe one of them honestly. -->
                    <CheckBox Style="{StaticResource DarkCheckBox}"
                              IsChecked="{Binding StartAtSignIn}"
                              Content="Start when I sign in to this server"
                              Margin="0,0,0,4"/>

                    <TextBlock Text="No administrator approval needed. Opens the app automatically whenever this Windows account signs in — but nothing syncs while nobody is signed in."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#94a3b8"
                               Margin="24,0,0,4"/>

                    <TextBlock Text="{Binding SignInStartupStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#60a5fa"
                               Margin="24,0,0,14"/>

                    <CheckBox Style="{StaticResource DarkCheckBox}"
                              IsChecked="{Binding RunAsBackgroundService}"
                              Content="Sync in the background even when nobody is signed in"
                              Margin="0,0,0,4"/>

                    <TextBlock Text="Installs a Windows service, so syncing resumes after a restart with nobody logged in. Windows asks for administrator approval once, when you tick this. If nobody can approve it on this server, use the option above instead."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#94a3b8"
                               Margin="24,0,0,4"/>

                    <TextBlock Text="{Binding ServiceStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#60a5fa"
                               Margin="24,0,0,14"/>

                    <CheckBox Style="{StaticResource DarkCheckBox}"
                              IsChecked="{Binding StartMinimized}"
                              Content="Start minimized to the notification area"/>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Padding="24,10"
                        FontSize="14"
                        Margin="0,0,16,0">
                    <TextBlock Text="Save Settings"/>
                </Button>
                <Button Style="{StaticResource BaseButton}"
                        Command="{Binding ResetWatermarksCommand}"
                        Padding="16,10"
                        FontSize="13"
                        Margin="0,0,16,0"
                        ToolTip="Deletes all watermark files so the next sync fetches ALL data from the last 2 years (full re-sync)">
                    <TextBlock Text="↺ Reset &amp; Full Sync"/>
                </Button>
                <TextBlock Text="{Binding SaveResult}"
                           Foreground="{Binding SaveResultColor}"
                           VerticalAlignment="Center"
                           FontSize="13"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
