<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity
    version="1.0.0.0"
    name="JtlSyncEngine.app" />
  <!--
    asInvoker, deliberately.

    This used to be requireAdministrator, which made Windows raise a UAC prompt on
    EVERY launch of the app — not only when registering the background service. On a
    server whose administrator account has a password, that prompt cannot be answered
    from the operator's session at all, so the Sync Engine could not be started there.

    It also silently blocked automatic startup: Windows refuses to auto-run a
    requireAdministrator executable from HKCU\...\Run, so the "start when I sign in"
    entry would have been registered and then ignored.

    Nothing in the app needs elevation to run. The two operations that do — installing
    and removing the Windows Service — re-launch PowerShell with Verb="runas" and ask
    for approval only at that moment. See WindowsServiceRegistrationManager.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel
          level="asInvoker"
          uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{4f476546-9376-4f16-bcd4-6b1f7f7888e5}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
