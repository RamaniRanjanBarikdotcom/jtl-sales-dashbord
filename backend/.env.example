# Copy this file to backend/.env for local Docker/dev.
# Never commit real .env files.

PORT=3001
NODE_ENV=development
APP_VERSION=1.0.0
BUILD_SHA=development
BUILD_TIME=unknown

# PostgreSQL
# Docker Compose does not start a local Postgres container.
# Use your online/managed Postgres host here.
PG_HOST=CHANGE_ME_online_postgres_host
PG_PORT=5432
PG_DATABASE=jtl_analytics
PG_USER=jtl_api
PG_PASSWORD=CHANGE_ME_online_database_password
PG_SSL=true
PG_SSL_VERIFY=true
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=15000
PG_IDLE_TIMEOUT_MS=30000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_local_redis_password

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_64_char_random_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_different_64_char_random_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend origins. Comma-separated values are supported.
FRONTEND_URL=http://localhost:3000

# Email / SMTP
# Leave MAIL_ENABLED=false until SMTP is configured and tested.
MAIL_ENABLED=false
MAIL_FROM="JTL Analytics <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_HELO_NAME=localhost

# Cookies
COOKIE_SECURE=
COOKIE_SAMESITE=strict
COOKIE_PATH=/
# COOKIE_DOMAIN=localhost

# Body/security limits
BODY_LIMIT=10mb
JSON_MAX_DEPTH=6
ALLOW_NGROK_ORIGINS=true
SWAGGER_ENABLED=true

# Ingest/retry tuning
INGEST_RETRY_MAX_ATTEMPTS=3
INGEST_RETRY_BASE_DELAY_MS=400
INGEST_BULK_ID_CHUNK=5000
INVENTORY_REQUIRE_SOURCE_METADATA=true
INVENTORY_ZERO_STOCK_POLICY=verify

# Health/detail tuning
HEALTH_TENANT_SAMPLE_LIMIT=200

# Maintenance
MATVIEW_REFRESH_INTERVAL_MINUTES=30

# Seeder
SUPER_ADMIN_EMAIL=superadmin@jtl.com
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=CHANGE_ME_Strong_Admin_Password_123!
SUPER_ADMIN_RESET=false
# Unified operations features. Remote controls, logs, and AI are opt-in.
SYNC_CONTROL_HEARTBEAT_ENABLED=true
SYNC_CONTROL_STATUS_ENABLED=true
SYNC_CONTROL_COMMANDS_ENABLED=false
SYNC_CONTROL_MODULE_RESYNC_ENABLED=false
SYNC_CONTROL_ADVANCED_COMMANDS_ENABLED=false
SYNC_CONTROL_ALLOW_OFFLINE_QUEUE=true
SYNC_CONTROL_AGENT_STATUS_CACHE_TTL_SECONDS=10
SYNC_CONTROL_HEARTBEAT_INTERVAL_SECONDS=30
SYNC_CONTROL_COMMAND_POLL_SECONDS=10
SYNC_CONTROL_LEASE_SECONDS=120
SYNC_CONTROL_MIN_AGENT_VERSION=
USE_MOCK_SYNC_DATA=false
SYSTEM_LOGS_ENABLED=false
SYSTEM_LOGS_API_ENABLED=false
SYSTEM_LOGS_UI_ENABLED=false
SYSTEM_LOGS_AGENT_EVENTS_ENABLED=false
SYSTEM_LOGS_EXPORT_ENABLED=false
SYSTEM_LOGS_SECURITY_TAB_ENABLED=false
SYSTEM_LOGS_RETENTION_ENABLED=false
SYSTEM_LOGS_LIVE_POLL_SECONDS=15
SYSTEM_LOGS_MAX_PAGE_SIZE=200
SYSTEM_LOGS_METADATA_MAX_BYTES=32768
SYSTEM_LOGS_EXPORT_MAX_ROWS=5000
SYSTEM_LOGS_RETENTION_INTERVAL_HOURS=24
AI_ANALYTICS_ENABLED=false
AI_ANALYTICS_SALES_ENABLED=false
AI_ANALYTICS_OPERATIONS_ENABLED=false
AI_ANALYTICS_LOGS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER_TIMEOUT_MS=20000
AI_MAX_TOOL_CALLS=4
AI_MAX_OUTPUT_TOKENS=800
AI_HISTORY_TURNS=8

# Signed sync-agent updates. Keep disabled until migration 15, signing keys,
# release storage, a signed bridge build, and a Windows pilot are complete.
SYNC_AGENT_UPDATE_ENABLED=false
SYNC_AGENT_UPDATE_REQUEST_ENABLED=false
SYNC_AGENT_AUTO_UPDATE_ENABLED=false
SYNC_AGENT_RELEASE_MANAGEMENT_ENABLED=false
SYNC_AGENT_UPDATE_CHANNEL=stable
SYNC_AGENT_UPDATE_HEALTH_TIMEOUT_SECONDS=120
SYNC_AGENT_UPDATE_MAX_BACKUPS=2
SYNC_AGENT_MINIMUM_VERSION=
SYNC_AGENT_RELEASE_ALLOWED_HOSTS=
SYNC_AGENT_RELEASE_MAX_PACKAGE_BYTES=536870912
SYNC_AGENT_RELEASE_STORAGE_PATH=/app/agent-releases
SYNC_AGENT_MANIFEST_PRIVATE_KEY_PEM=
SYNC_AGENT_MANIFEST_PUBLIC_KEY_PEM=
COMPARISON_CENTRE_ENABLED=false
COMPARISON_CHANNEL_DRILLDOWN_ENABLED=false
COMPARISON_PRODUCT_PERFORMANCE_ENABLED=false
COMPARISON_INVENTORY_PERFORMANCE_ENABLED=false
COMPARISON_CUSTOMER_ANALYSIS_ENABLED=false
ANALYTICS_COPILOT_DATA_ENABLED=false
